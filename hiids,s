package com.docmanager.service;

import com.docmanager.dto.apis.entities.Infrastructure;
import com.docmanager.repository.InfrastructureRepository;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

@Service
@RequiredArgsConstructor
@Slf4j
public class ServiceVersionService implements GetInfoServices {
    private final RestTemplate restTemplate;
    private final InfrastructureRepository infrastructureRepository;

    public List<ServiceInfo> handle(GetServiceInfoByEnv request, RequestContext context) {
        // Si l'environnement n'est pas spécifié, on utilise DEV par défaut
        String env = (request.getEnvironment() != null)
            ? request.getEnvironment().toString().toUpperCase()
            : "DEV";

        log.info("Handling GetServiceInfoByEnv request for environment: {}", env);

        List<ServiceInfo> result = new ArrayList<>();
        List<Infrastructure> infrastructures = infrastructureRepository.findAll();
        DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm");

        for (Infrastructure infra : infrastructures) {
            try {
                ServiceInfo serviceInfo = new ServiceInfo();
                serviceInfo.setServiceName(infra.getName());

                // Récupérer la version en fonction de l'environnement
                String version;
                String url;
                switch (env) {
                    case "DEV", "INT" -> {
                        url = infra.getUrlInt();
                        version = fetchVersionFromUrl(url);
                        infra.setVersionDev(version);
                    }
                    case "UAT", "HF" -> {
                        url = infra.getUrlUat();
                        version = fetchVersionFromUrl(url);
                        infra.setVersionHf(version);
                    }
                    case "OAT", "HT" -> {
                        url = infra.getUrlOat();
                        version = fetchVersionFromUrl(url);
                        infra.setVersionHt(version);
                    }
                    default -> {
                        log.warn("Environnement non reconnu: {}, utilisation de DEV par défaut", env);
                        url = infra.getUrlInt();
                        version = fetchVersionFromUrl(url);
                        infra.setVersionDev(version);
                    }
                }

                // Mettre à jour le timestamp
                infra.setLastUpdate(LocalDateTime.now());
                infrastructureRepository.save(infra);

                // Remplir le ServiceInfo avec toutes les versions
                serviceInfo.setVersionDev(infra.getVersionDev());
                serviceInfo.setVersionHf(infra.getVersionHf());
                serviceInfo.setVersionHt(infra.getVersionHt());
                serviceInfo.setLastUpdate(infra.getLastUpdate().format(formatter));

                result.add(serviceInfo);
                log.info("Service info retrieved for {} in environment {}: version={}",
                    infra.getName(), env, version);

            } catch (Exception e) {
                log.error("Error processing infrastructure {}: {}", infra.getName(), e.getMessage());
                ServiceInfo errorInfo = new ServiceInfo();
                errorInfo.setServiceName(infra.getName());
                errorInfo.setVersionDev("-");
                errorInfo.setVersionHf("-");
                errorInfo.setVersionHt("-");
                errorInfo.setLastUpdate(LocalDateTime.now().format(formatter));
                result.add(errorInfo);
            }
        }

        return result;
    }

    private String fetchVersionFromUrl(String url) {
        if (url == null || url.isEmpty()) {
            log.warn("URL is null or empty");
            return "-";
        }

        try {
            Map<String, Object> response = restTemplate.getForObject(url, Map.class);

            if (response != null && response.containsKey("version")) {
                Object version = response.get("version");
                if (version instanceof String && !((String) version).isBlank()) {
                    log.info("Found version {} for URL: {}", version, url);
                    return (String) version;
                }
            }

            log.warn("No valid version found in response for URL: {}", url);
            return "-";

        } catch (Exception e) {
            log.error("Error fetching version from {}: {}", url, e.getMessage());
            return "-";
        }
    }
}