@Component
@RequiredArgsConstructor
@Slf4j
public class APIServiceMapper {

    private final ServiceVersionService serviceVersionService;
    private final InfrastructureRepository infrastructureRepository;

    public void updateEntityFromRequest(APIService entity, CreateAPIServiceRequest request) {
        entity.setName(request.getName());
        entity.setTrigramme(request.getTrigramme());
        entity.setDescription(request.getDescription());
        entity.setDatabaseSchema(request.getDatabaseSchema());

        // Recherche de l'infrastructure par nom
        log.info("Looking for infrastructure with name: {}", request.getName());
        Optional<Infrastructure> existingInfra = infrastructureRepository.findByName(request.getName());

        if (existingInfra.isPresent()) {
            log.info("Found existing infrastructure for service: {}", request.getName());
            entity.setInfrastructure(existingInfra.get());
        } else {
            log.warn("No infrastructure found for service: {}. Creating new one.", request.getName());
            // Créer une nouvelle infrastructure si nécessaire
            Infrastructure newInfra = new Infrastructure();
            newInfra.setName(request.getName());
            newInfra.setUrlInt("https://int-" + request.getName().toLowerCase().replace(" ", "-") + ".bankingsolutions.com");
            newInfra.setUrlUat("https://uat-" + request.getName().toLowerCase().replace(" ", "-") + ".bankingsolutions.com");
            newInfra.setUrlOat("https://oat-" + request.getName().toLowerCase().replace(" ", "-") + ".bankingsolutions.com");
            newInfra.setUrlProd("https://" + request.getName().toLowerCase().replace(" ", "-") + ".bankingsolutions.com");
            entity.setInfrastructure(serviceVersionService.fetchVersions(newInfra));
        }

        // ... reste du code inchangé ...
    }

    public APIServiceDTO toDTO(APIService entity) {
        log.info("Starting toDTO conversion for service: {}", entity.getName());
        APIServiceDTO dto = new APIServiceDTO();

        // ... autres mappings ...

        // Mappage de l'infrastructure avec vérification par nom
        if (entity.getInfrastructure() != null) {
            Infrastructure infra = entity.getInfrastructure();
            // Vérifier si l'infrastructure existe toujours dans le repository
            Optional<Infrastructure> existingInfra = infrastructureRepository.findByName(entity.getName());
            if (existingInfra.isPresent()) {
                infra = existingInfra.get();
                log.info("Found infrastructure in repository for service: {}", entity.getName());
            }

            InfrastructureDTO infraDTO = new InfrastructureDTO(
                infra.getUrlInt(),
                infra.getUrlUat(),
                infra.getUrlOat(),
                infra.getUrlProd()
            );
            dto.setInfrastructure(infraDTO);
        } else {
            log.warn("Infrastructure is null for service: {}", entity.getName());
        }

        // ... reste du code ...
        return dto;
    }
}

