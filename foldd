    interface ManageTechItemParams {
      serviceId: string;
      techItemName: string;
      enabled: boolean;
    }

    export const useManageTechItem = () => {
      const queryClient = useQueryClient();

      return useMutation({
        mutationFn: ({ serviceId, techItemName, enabled }: ManageTechItemParams) =>
          apiDocumentationService.manageTechItem(serviceId, techItemName, enabled),
        onSuccess: (_data, variables) => {
          // Invalidate the service query to refresh the data
          queryClient.invalidateQueries({ queryKey: ['service', variables.serviceId] });
          queryClient.invalidateQueries({ queryKey: ['services'] });
        },
      });
    };


