// ServicesListWithTechNews.tsx
import React, { useState } from 'react';
import { BarChart3 } from 'lucide-react';

export function TechNewsSection({ service, refreshService }) {
    const [techNews, setTechNews] = useState(service.techNews || []);
    const [newTechTitle, setNewTechTitle] = useState('');
    const [newTechValue, setNewTechValue] = useState('');
    const [loading, setLoading] = useState(false);

    // Ajout d'une actualité technique
    const handleAddTechNews = async (e) => {
        e.preventDefault();
        setLoading(true);
        const res = await fetch('/api/technews', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                serviceId: service.id,
                title: newTechTitle,
                value: newTechValue
            })
        });
        if (res.ok) {
            setNewTechTitle('');
            setNewTechValue('');
            refreshService(); // Pour recharger la liste depuis le parent
        }
        setLoading(false);
    };

    // Désactivation/réactivation d'une actualité
    const handleToggleTechNews = async (id, enabled) => {
        setLoading(true);
        await fetch(`/api/technews/${id}/toggle`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ enabled: !enabled })
        });
        refreshService();
        setLoading(false);
    };

    return (
        <div className="space-y-4">
            <h4 className="text-xs font-bold uppercase text-neutral-500 tracking-wider flex items-center">
                <BarChart3 className="w-3.5 h-3.5 mr-1.5" />
                TECH
            </h4>
            <div className="space-y-3">
                {/* ... autres éléments techniques ... */}
                <div className="mt-4">
                    <h5 className="font-semibold text-sm mb-2">Actualités techniques</h5>
                    <div className="max-h-32 overflow-y-auto space-y-2">
                        {techNews.length === 0 && (
                            <div className="text-xs text-neutral-400">Aucune actualité technique</div>
                        )}
                        {techNews.map(news => (
                            <div
                                key={news.id}
                                className={`flex items-center justify-between px-3 py-2 rounded ${news.enabled ? 'bg-neutral-100' : 'bg-neutral-50 opacity-50'}`}
                            >
                                <span>
                                    <strong>{news.title}:</strong> {news.value}
                                </span>
                                <button
                                    className={`text-xs ${news.enabled ? 'text-red-500' : 'text-green-500'} hover:underline`}
                                    onClick={e => { e.stopPropagation(); handleToggleTechNews(news.id, news.enabled); }}
                                    disabled={loading}
                                >
                                    {news.enabled ? 'Désactiver' : 'Réactiver'}
                                </button>
                            </div>
                        ))}
                    </div>
                    <form className="flex space-x-2 mt-2" onSubmit={handleAddTechNews}>
                        <input
                            type="text"
                            placeholder="Titre"
                            value={newTechTitle}
                            onChange={e => setNewTechTitle(e.target.value)}
                            className="border rounded px-2 py-1 text-xs"
                            required
                        />
                        <input
                            type="text"
                            placeholder="Valeur"
                            value={newTechValue}
                            onChange={e => setNewTechValue(e.target.value)}
                            className="border rounded px-2 py-1 text-xs"
                            required
                        />
                        <button
                            type="submit"
                            className="bg-primary-500 text-white px-3 py-1 rounded text-xs"
                            disabled={loading}
                        >
                            Ajouter
                        </button>
                    </form>
                </div>
            </div>
        </div>
    );
}

