package com.docmanager.dto.apis.usecases.technews;

import com.docmanager.dto.apis.entities.APIService;
import com.docmanager.dto.apis.entities.TechNews;
import com.docmanager.dto.apis.repositories.APIServiceRepository;
import com.docmanager.dto.apis.repositories.TechNewsRepository;
import com.docmanager.dto.apis.usecases.RequestContext;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class CreateTechNewsImpl implements CreateTechNews {
    private final APIServiceRepository apiServiceRepository;
    private final TechNewsRepository techNewsRepository;

    public CreateTechNewsImpl(APIServiceRepository apiServiceRepository, TechNewsRepository techNewsRepository) {
        this.apiServiceRepository = apiServiceRepository;
        this.techNewsRepository = techNewsRepository;
    }

    @Override
    @Transactional
    public TechNews handle(CreateTechNewsRequest input, RequestContext context) {
        APIService service = apiServiceRepository.findById(input.getServiceId())
            .orElseThrow(() -> new IllegalArgumentException("Service not found"));
        TechNews news = new TechNews();
        news.setTitle(input.getTitle());
        news.setValue(input.getValue());
        news.setEnabled(true);
        news.setService(service);
        return techNewsRepository.save(news);
    }
}

@Service
public class ToggleTechNewsImpl implements ToggleTechNews {
    private final TechNewsRepository techNewsRepository;

    public ToggleTechNewsImpl(TechNewsRepository techNewsRepository) {
        this.techNewsRepository = techNewsRepository;
    }

    @Override
    @Transactional
    public TechNews handle(ToggleTechNewsRequest input, RequestContext context) {
        TechNews news = techNewsRepository.findById(input.getTechNewsId())
            .orElseThrow(() -> new IllegalArgumentException("TechNews not found"));
        news.setEnabled(input.isEnabled());
        return techNewsRepository.save(news);
    }
}

