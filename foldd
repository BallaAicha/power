const [techNews, setTechNews] = useState(service.techNews || []);
const [newTechTitle, setNewTechTitle] = useState('');
const [newTechValue, setNewTechValue] = useState('');

const handleAddTechNews = async () => {
    // Appel API pour ajouter une actualité
    const res = await fetch('/api/technews', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            serviceId: service.id,
            title: newTechTitle,
            value: newTechValue
        })
    });
    const created = await res.json();
    setTechNews([...techNews, created]);
    setNewTechTitle('');
    setNewTechValue('');
};

const handleToggleTechNews = async (id: string, enabled: boolean) => {
    await fetch(`/api/technews/${id}/toggle`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: !enabled })
    });
    setTechNews(techNews.map(n => n.id === id ? { ...n, enabled: !enabled } : n));
};

// Dans le render, dans la section TECH :
<div className="space-y-4">
    <h4 className="text-xs font-bold uppercase text-neutral-500 tracking-wider flex items-center">
        <BarChart3 className="w-3.5 h-3.5 mr-1.5" />
        TECH
    </h4>
    <div className="space-y-3">
        {/* ... Java 17 et Sonarization ... */}
        <div className="mt-4">
            <h5 className="font-semibold text-sm mb-2">Actualités techniques</h5>
            <ul className="space-y-2">
                {techNews.filter(n => n.enabled).map(news => (
                    <li key={news.id} className="flex items-center justify-between bg-neutral-100 rounded px-3 py-2">
                        <span>
                            <strong>{news.title}:</strong> {news.value}
                        </span>
                        <button
                            className="text-xs text-red-500 hover:underline"
                            onClick={() => handleToggleTechNews(news.id, news.enabled)}
                        >
                            Désactiver
                        </button>
                    </li>
                ))}
                {techNews.filter(n => !n.enabled).map(news => (
                    <li key={news.id} className="flex items-center justify-between bg-neutral-50 rounded px-3 py-2 opacity-50">
                        <span>
                            <strong>{news.title}:</strong> {news.value}
                        </span>
                        <button
                            className="text-xs text-green-500 hover:underline"
                            onClick={() => handleToggleTechNews(news.id, news.enabled)}
                        >
                            Réactiver
                        </button>
                    </li>
                ))}
            </ul>
            <div className="flex space-x-2 mt-2">
                <input
                    type="text"
                    placeholder="Titre"
                    value={newTechTitle}
                    onChange={e => setNewTechTitle(e.target.value)}
                    className="border rounded px-2 py-1 text-xs"
                />
                <input
                    type="text"
                    placeholder="Valeur"
                    value={newTechValue}
                    onChange={e => setNewTechValue(e.target.value)}
                    className="border rounded px-2 py-1 text-xs"
                />
                <button
                    className="bg-primary-500 text-white px-3 py-1 rounded text-xs"
                    onClick={handleAddTechNews}
                >
                    Ajouter
                </button>
            </div>
        </div>
    </div>
</div>