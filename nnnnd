// 1. IMPORTS À AJOUTER (ligne 1)
import React, { useState, useEffect } from 'react';

// 2. ÉTAT ET CONFIGURATION (après la déclaration du composant, avant containerVariants)
const [currentEnvironmentIndex, setCurrentEnvironmentIndex] = useState(0);

// Définition des environnements et leurs versions
const environments = [
    { name: 'Dev', key: 'urlDev', color: 'bg-blue-50 text-blue-700 border-blue-200' },
    { name: 'HF', key: 'urlHf', color: 'bg-purple-50 text-purple-700 border-purple-200' },
    { name: 'HT', key: 'urlHt', color: 'bg-indigo-50 text-indigo-700 border-indigo-200' },
    { name: 'INT', key: 'urlInt', color: 'bg-orange-50 text-orange-700 border-orange-200' },
    { name: 'UAT', key: 'urlUat', color: 'bg-yellow-50 text-yellow-700 border-yellow-200' },
    { name: 'OAT', key: 'urlOat', color: 'bg-pink-50 text-pink-700 border-pink-200' },
    { name: 'PROD', key: 'urlProd', color: 'bg-red-50 text-red-700 border-red-200' }
];

// Rotation des environnements toutes les 10 secondes
useEffect(() => {
    const interval = setInterval(() => {
        setCurrentEnvironmentIndex((prevIndex) =>
            (prevIndex + 1) % environments.length
        );
    }, 10000);

    return () => clearInterval(interval);
}, [environments.length]);

// Fonction pour obtenir la version actuelle selon l'environnement
const getCurrentVersion = (service: APIService) => {
    const currentEnv = environments[currentEnvironmentIndex];
    const version = service.infrastructure?.[currentEnv.key as keyof typeof service.infrastructure];

    // Si c'est une URL, on extrait la version ou on utilise un indicateur
    if (version && version !== '') {
        if (version.startsWith('http')) {
            // C'est une URL, on utilise un indicateur d'environnement
            return {
                environment: currentEnv.name,
                version: 'En ligne',
                color: currentEnv.color,
                isUrl: true
            };
        } else {
            // C'est une version directe
            return {
                environment: currentEnv.name,
                version,
                color: currentEnv.color,
                isUrl: false
            };
        }
    }

    // Fallback vers la version générale si pas de version spécifique
    return {
        environment: currentEnv.name,
        version: 'Non déployé',
        color: 'bg-gray-50 text-gray-700 border-gray-200',
        isUrl: false
    };
};

// 3. DANS LA BOUCLE MAP (après const criticalityData = getCriticalityData(service.criticality);)
const currentVersion = getCurrentVersion(service);

// 4. REMPLACER LE BADGE DE VERSION (remplacer la span existante)
<motion.span
    key={`${service.id}-${currentEnvironmentIndex}`}
    initial={{ opacity: 0, scale: 0.8 }}
    animate={{ opacity: 1, scale: 1 }}
    transition={{ duration: 0.3, ease: "easeOut" }}
    className={`inline-flex items-center px-3 py-1.5 rounded-full text-xs font-medium border shadow-sm ${currentVersion.color}`}
>
    {currentVersion.environment} - {currentVersion.isUrl ? currentVersion.version : `v${currentVersion.version}`}
</motion.span>